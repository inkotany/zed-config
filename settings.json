{
  "ui_font_family": "JetBrains Mono",
  "diff_view_style": "unified",
  "vertical_scroll_margin": 3.0,
  "excerpt_context_lines": 2,
  "expand_excerpt_lines": 5,
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "postgres-language-server": {
      "binary": {
        "path": "C:\\tools\\postgrestools_x86_64-pc-windows-msvc.exe",
        "arguments": ["lsp-proxy"],
      },
    },
  },
  "which_key": {
    "enabled": false,
  },
  "accessible_mode": false,
  "completions": {
    "words_min_length": 3,
  },
  "indent_guides": {
    "enabled": false
  },
  "preferred_line_length": 45,
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false
  },
  "show_wrap_guides": true,
  "minimum_contrast_for_highlights": 45.0,
  "agent_ui_font_size": 16.0,
  "buffer_line_height": "comfortable",
  "outline_panel": {
    "expand_outlines_with_depth": 100,
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "cli_default_open_behavior": "new_window",
  "proxy": "",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_weight": 450.0,
  "buffer_font_family": "JetBrains Mono",
  "project_panel": {
    "dock": "right",
    "default_width": 400,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "sticky_scroll": false,
  },
  "format_on_save": "on",
  "auto_update_extensions": {
    "nestjs-snippets": false,
  },
  "git_panel": {
    "dock": "left",
  },
  "debugger": {
    "dock": "left",
  },
  "terminal": {
    "font_family": "JetBrains Mono NL",
    "dock": "left",
    "shell": {
      "program": "C:\\Program Files\\Git\\bin\\bash.exe",
    },
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": false,
  "icon_theme": {
    "mode": "system",
    "light": "VSCode Icons for Zed (Dark Angular)",
    "dark": "VSCode Icons for Zed (Dark NestJS)",
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "Ayu Mirage",
    "dark": "Ayu Mirage",
  },
  "theme_overrides": {
    "Ayu Mirage": {
      "border": "#1F2430",
      "border.variant": "#1F2430",
      "title_bar.background": "#1F2430",
      "panel.background": "#1F2430",
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    "experimental.show": false,
  },
  "scrollbar": {
    "show": "never",
  },
}
